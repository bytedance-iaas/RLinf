{
  "name": "rlinf-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arco-inspired operator console for RLinf training runs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:scales": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check_scales.mjs",
    "check:identity": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check_identity.mjs",
    "check:i18n": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check_i18n.mjs",
    "tokens": "python scripts/gen_tokens.py",
    "tokens:check": "python scripts/gen_tokens.py --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
